# Render and scratch output
_render_*/
*.log

# Raw files emailed by the club (photos of people, large originals). Public
# repo, so they stay on the build machine; what the site uses lives in
# site/public or the media library.
content/client-assets/

# Site secrets (site/.gitignore also covers these)
site/.env
site/.env*.local
site/.vercel/

# template leftovers not used on Vercel
site/test.env
